# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# --- Microsoft Exchange Online (Microsoft Graph, app-only auth) ---
MS_TENANT_ID=00000000-0000-0000-0000-000000000000
MS_CLIENT_ID=00000000-0000-0000-0000-000000000000
MS_CLIENT_SECRET=your-client-secret
# Mailbox the app reads, e.g. orders@yourcompany.com
MS_MAILBOX=orders@yourcompany.com
# Folder to read from (display name or well-known name like "inbox")
MS_SOURCE_FOLDER=inbox
# After processing, move the email here (blank = leave in place, just mark read)
MS_PROCESSED_FOLDER=Orders Processed

# --- App ---
DB_PATH=data/orders.db
ATTACHMENT_DIR=data/attachments
# Orders below this confidence are flagged "needs_review"
REVIEW_CONFIDENCE_THRESHOLD=0.75
